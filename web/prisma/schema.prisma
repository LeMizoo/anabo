generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  NOUVEAU
  CONTACTE
  DEVIS_ENVOYE
  CONFIRME
  PERDU
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

model QuoteRequest {
  id        String      @id @default(cuid()) @db.VarChar(30)
  reference String      @unique @db.VarChar(32)
  status    QuoteStatus @default(NOUVEAU)
  locale    String      @default("fr") @db.VarChar(2)

  firstName String  @db.VarChar(100)
  lastName  String  @db.VarChar(100)
  email     String  @db.VarChar(191)
  phone     String  @db.VarChar(40)
  country   String? @db.VarChar(100)

  circuitSlug  String?   @db.VarChar(191)
  circuitTitle String?   @db.VarChar(191)
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  adults       Int       @default(2)
  children     Int       @default(0)
  message      String?   @db.Text
  adminNotes   String?   @db.Text
  
  // Champs pour le devis
  quoteDetails String?   @db.Text

  // Estimation tarifaire (instantané au moment de la demande).
  // Prix par véhicule et par jour, jamais par personne. Durée en fourchette (min-max).
  vehicleId   String? @db.VarChar(30)
  vehicleName String? @db.VarChar(100)
  season      String? @db.VarChar(10) // "dry" | "rainy"
  daysMin     Int?
  daysMax     Int?
  dailyRate   Int?    // tarif/jour du véhicule en euros au moment de la demande
  priceMin    Int?    // daysMin x dailyRate, en euros
  priceMax    Int?    // daysMax x dailyRate, en euros

  contactedAt DateTime?
  quoteSentAt DateTime?
  confirmedAt DateTime?
  lostAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([circuitSlug])
}

model AdminUser {
  id           String    @id @default(cuid()) @db.VarChar(30)
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Véhicules et tarifs journaliers (en euros), modifiables dans /admin/prix.
// Prix par véhicule et par jour, jamais par personne.
model Vehicle {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @db.VarChar(100) // ex. "4x4", "Mini van"
  modelName String   @default("") @db.VarChar(100) // modèle indicatif (Prado, Grand Starex)
  seats     Int      // nombre de places passagers
  dailyRate Int      // prix par jour, en euros
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Durée des circuits selon la saison, en fourchette de jours (qualité des routes).
// circuitKey = translationGroup du circuit dans Sanity (commun à fr, en et it).
model CircuitDuration {
  circuitKey String   @id @db.VarChar(191)
  dryMin     Int?
  dryMax     Int?
  rainyMin   Int?
  rainyMax   Int?
  updatedAt  DateTime @updatedAt
}
