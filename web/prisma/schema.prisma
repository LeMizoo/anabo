generator client {
  provider   = "prisma-client"
  engineType = "client"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  NOUVEAU
  CONTACTE
  DEVIS_ENVOYE
  CONFIRME
  PERDU
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  CHAUFFEUR
}

enum PricingMode {
  DAILY_CAR
  TOUR_INCLUDED
}

enum PricingUnit {
  PER_PERSON
  PER_DAY
  PER_VEHICLE
  FIXED
}

enum PackagePricingScope {
  DAILY_CAR
  TOUR_INCLUDED
  BOTH
}

// Nouveaux paramètres de durée
enum TravelSeason {
  DRY
  RAINY
}

enum RoadCondition {
  GOOD
  MEDIUM
  DIFFICULT
}

model QuoteRequest {
  id        String      @id @default(cuid()) @db.VarChar(30)
  reference String      @unique @db.VarChar(32)
  status    QuoteStatus @default(NOUVEAU)
  locale    String      @default("fr") @db.VarChar(2)

  firstName String  @db.VarChar(100)
  lastName  String  @db.VarChar(100)
  email     String  @db.VarChar(191)
  phone     String  @db.VarChar(40)
  country   String? @db.VarChar(100)

  circuitSlug  String?   @db.VarChar(191)
  circuitTitle String?   @db.VarChar(191)
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  adults       Int       @default(2)
  children     Int       @default(0)
  message      String?   @db.Text
  adminNotes   String?   @db.Text

  // Informations historiques de devis
  quoteDetails        String?      @db.Text
  estimateDetails     String?      @db.Text
  vehicleCode         String?      @db.VarChar(120)
  vehicleLabel        String?      @db.VarChar(120)
  pricingMode         PricingMode?
  pricingPackageId    String?      @db.VarChar(30)
  pricingPackageName  String?      @db.VarChar(120)
  vehicleCount        Int          @default(1)
  consecutiveCircuits Int          @default(1)

  // Informations du nouveau traitement de devis
  tripSeason           TravelSeason?
  roadCondition        RoadCondition?
  indicativeMinDays    Int?
  indicativeMaxDays    Int?
  selectedDurationDays Int?

  contactedAt DateTime?
  quoteSentAt DateTime?
  confirmedAt DateTime?
  lostAt      DateTime?

  // Acceptation du devis par le client via son lien signé (preuve, jamais écrasée).
  // Sert de référence au calcul du délai d'annulation de 15 jours.
  clientAcceptedAt  DateTime?
  // Dates de voyage telles qu'acceptées par le client (conservées même si modifiées ensuite).
  acceptedStartDate DateTime?
  acceptedEndDate   DateTime?

  // Chauffeur(-guide) affecté au voyage
  assignedDriverId String? @db.VarChar(30)

  // Montant total du devis (pour calculer l'acompte) et suivi du paiement de l'acompte
  quoteTotalAmount Int?
  quoteCurrency    String?   @db.VarChar(3)
  depositPaidAt    DateTime?
  // Solde (reste du montant après l'acompte) encaissé
  balancePaidAt    DateTime?
  // Ventilation du montant total (comptabilité) : location, indemnité chauffeur, autres frais
  vehicleAmount    Int?
  driverAmount     Int?
  otherAmount      Int?
  // Indemnité reversée au chauffeur affecté
  driverPaidAt     DateTime?

  // Archivage : la demande sort des listes de travail et des alertes, sans être supprimée.
  archivedAt DateTime?
  archivedBy String?   @db.VarChar(191)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([circuitSlug])
  @@index([assignedDriverId])
  @@index([archivedAt])
}

// Nouveau catalogue global de véhicules
model VehicleType {
  id             String   @id @default(cuid()) @db.VarChar(30)
  code           String   @unique @db.VarChar(120)
  name           String   @db.VarChar(120)
  capacity       Int
  pricePerDay    Int      @default(0)
  currency       String   @default("EUR") @db.VarChar(3)
  indicativeOnly Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, name])
}

// Durées configurées pour chaque circuit, saison et état des routes
// Règles de retour à vide vers Antananarivo, paramétrables dans Admin > Prix et véhicules.
// Listes stockées en texte, valeurs séparées par des virgules.
model EmptyReturnRule {
  id           String   @id @default(cuid()) @db.VarChar(30)
  label        String   @db.VarChar(120)
  days         Int
  /// Jours si le véhicule est embarqué (ex. vers Nosy Be) ; vide = option non proposée.
  ferryDays    Int?
  circuitSlugs String   @db.Text
  regionValues String   @db.Text
  keywords     String?  @db.Text
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, sortOrder])
}

model CircuitDuration {
  id            String        @id @default(cuid()) @db.VarChar(30)
  circuitSlug   String        @db.VarChar(191)
  season        TravelSeason
  roadCondition RoadCondition
  minDays       Int
  maxDays       Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([circuitSlug, season, roadCondition])
  @@index([circuitSlug])
}

// ANCIENS MODÈLES CONSERVÉS POUR LA COMPATIBILITÉ
model PricingConfig {
  id               String           @id @default(cuid()) @db.VarChar(30)
  circuitSlug      String           @unique @db.VarChar(191)
  dailyCarEnabled  Boolean          @default(false)
  tourPriceEnabled Boolean          @default(false)
  tourPrice        Int?
  basePrice        Int              @default(0)
  currency         String           @default("EUR") @db.VarChar(3)
  vehicles         PricingVehicle[]
  packages         PricingPackage[]
  updatedAt        DateTime         @updatedAt
  createdAt        DateTime         @default(now())
}

model PricingVehicle {
  id             String        @id @default(cuid()) @db.VarChar(30)
  configId       String        @db.VarChar(30)
  code           String        @default("") @db.VarChar(120)
  aliases        String?       @db.Text
  name           String        @db.VarChar(120)
  capacity       Int
  pricePerDay    Int           @default(0)
  indicativeOnly Boolean       @default(false)
  config         PricingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, name])
  @@unique([configId, code])
}

model PricingPackage {
  id        String               @id @default(cuid()) @db.VarChar(30)
  configId  String               @db.VarChar(30)
  name      String               @db.VarChar(120)
  active    Boolean              @default(true)
  scope     PackagePricingScope  @default(BOTH)
  config    PricingConfig        @relation(fields: [configId], references: [id], onDelete: Cascade)
  items     PricingPackageItem[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([configId, name])
  @@index([configId])
}

model PricingPackageItem {
  id        String         @id @default(cuid()) @db.VarChar(30)
  packageId String         @db.VarChar(30)
  code      String         @db.VarChar(40)
  name      String         @db.VarChar(120)
  unit      PricingUnit    @default(FIXED)
  price     Int            @default(0)
  package   PricingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, code])
  @@index([packageId])
}

model PricingRule {
  id         String   @id @default(cuid()) @db.VarChar(30)
  kind       String   @db.VarChar(20)
  threshold  Int
  percentage Int
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@unique([kind, threshold])
}

model AdminUser {
  id           String    @id @default(cuid()) @db.VarChar(30)
  email        String    @unique @db.VarChar(191)
  name         String    @db.VarChar(150)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  /// Compte CHAUFFEUR : fiche chauffeur liée (son planning n'affiche que ses voyages)
  driverId     String?   @db.VarChar(30)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([driverId])
}

/// Abonnements aux notifications push des administrateurs (un par navigateur/appareil).
model AdminPushSubscription {
  id           String    @id @default(cuid()) @db.VarChar(30)
  adminUserId  String    @db.VarChar(30)
  endpointHash String    @unique @db.VarChar(64)
  endpoint     String    @db.Text
  p256dh       String    @db.VarChar(255)
  auth         String    @db.VarChar(255)
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([adminUserId])
}

/// Chauffeurs(-guides) : équipe permanente et renforts temporaires.
model Driver {
  id            String   @id @default(cuid()) @db.VarChar(30)
  name          String   @db.VarChar(150)
  phone         String?  @db.VarChar(40)
  email         String?  @db.VarChar(191)
  languages     String?  @db.VarChar(191)
  licenseNumber String?  @db.VarChar(80)
  vehicleLabel  String?  @db.VarChar(150)
  vehicleSeats  Int?
  isTemporary   Boolean  @default(false)
  active        Boolean  @default(true)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

/// Paramètres de paiement de l'acompte (une seule ligne, id = "default"). Modifiables par le SUPER_ADMIN.
model PaymentSettings {
  id             String   @id @default("default") @db.VarChar(30)
  method         String   @default("Mobile Money") @db.VarChar(80)
  phoneNumber    String   @default("+261 32 99 298 60") @db.VarChar(40)
  accountHolder  String?  @db.VarChar(150)
  depositPercent Int      @default(30)
  instructions   String?  @db.Text
  updatedBy      String?  @db.VarChar(191)
  updatedAt      DateTime @updatedAt
}
